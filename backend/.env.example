# ---- AceIt backend configuration template ----
# Copy this file to `.env` and fill in your own values:
#     cp backend/.env.example backend/.env
# The real .env file is git-ignored and never pushed to GitHub.

# Database
MONGO_URI=mongodb://localhost:27017/interview_coach
MONGO_DB=interview_coach

# External API keys (get your own free keys)
#   AssemblyAI (speech-to-text): https://www.assemblyai.com/
#   Groq (ideal-answer LLM):     https://console.groq.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Deep Learning / visual pipeline (optional overrides)
ANALYSIS_FPS=5
MAX_FRAMES=900
DELETE_VIDEO_AFTER_ANALYSIS=true

# Path to the isolated visual venv python (optional; auto-discovered if unset)
# ACEIT_VISUAL_PYTHON=/absolute/path/to/.venv-visual/bin/python
