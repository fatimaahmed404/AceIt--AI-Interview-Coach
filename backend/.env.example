# ---- AceIt backend configuration template ----
# Copy this file to `.env` and fill in your own values:
#     cp backend/.env.example backend/.env
# The real .env file is git-ignored and never pushed to GitHub.

# Database
MONGO_URI=mongodb://localhost:27017/interview_coach
MONGO_DB=interview_coach

# External API keys (get your own free keys)
#   AssemblyAI (speech-to-text): https://www.assemblyai.com/
#   Groq (ideal-answer LLM):     https://console.groq.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Deep Learning / visual pipeline (optional overrides)
ANALYSIS_FPS=5
MAX_FRAMES=900
DELETE_VIDEO_AFTER_ANALYSIS=true

# Path to the isolated visual venv python (optional; auto-discovered if unset)
# ACEIT_VISUAL_PYTHON=/absolute/path/to/.venv-visual/bin/python

# ===========================================================================
# Authentication & account management
# ===========================================================================
# development | production  (production forces Secure cookies & HTTPS links)
APP_ENV=development

# Secret for signing CSRF tokens. Generate a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Public URLs used in emails and redirects (no trailing slash)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:5000

# Comma-separated CORS allowlist (origins allowed to send credentialed requests)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie settings
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=
SESSION_LIFETIME_DAYS=30
SESSION_SHORT_HOURS=12

# Password policy / token lifetimes
PASSWORD_MIN_LENGTH=12
EMAIL_VERIFY_TOKEN_HOURS=24
RESET_OTP_MINUTES=10
RESET_OTP_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60

# ===========================================================================
# SMTP email (transactional email: verification, password reset, etc.)
# Example providers: Mailtrap (dev sandbox), SendGrid, Mailgun, Gmail app pwd.
# Leave SMTP_HOST empty to use the console fallback (prints emails to the log).
# ===========================================================================
# Gmail example (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#   SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>,
#   MAIL_FROM_ADDRESS=you@gmail.com   (Gmail requires From == your address)
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true for implicit TLS (port 465); false for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT=15
MAIL_FROM_NAME=AceIt
# Must be a real sender you're allowed to send from (for Gmail, your address).
MAIL_FROM_ADDRESS=no-reply@aceit.local
# When true, if SMTP is not configured the email body is logged instead of sent
MAIL_CONSOLE_FALLBACK=true
